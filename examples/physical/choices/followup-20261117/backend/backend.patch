--- a/audit.tcl
+++ b/audit.tcl
@@ -29,3 +29,16 @@
   }
 }
 foreach row [lsort $records] {puts "PAPER_PIN $row"}
+
+set core_sum 0.0
+set core_count 0
+foreach net [$block getNets] {
+  if {[$net getSigType] in {POWER GROUND} || [llength [$net getBTerms]] > 0} {continue}
+  set rect [$net getTermBBox]
+  set dx [expr {[$rect xMax] - [$rect xMin]}]
+  set dy [expr {[$rect yMax] - [$rect yMin]}]
+  if {$dx < 0 || $dy < 0} {continue}
+  set core_sum [expr {$core_sum + ($dx + $dy) / double($units)}]
+  incr core_count
+}
+puts "CORE_AUDIT_STAGE $::env(STAGE) HPWL_UM $core_sum NETS $core_count"
